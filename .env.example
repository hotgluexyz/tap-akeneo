# Permanent token from Akeneo Apps OAuth. Never commit real credentials.
TAP_AKENEO_BASE_URL=https://your-pim.cloud.akeneo.com
TAP_AKENEO_ACCESS_TOKEN=YOUR_APP_ACCESS_TOKEN
TAP_AKENEO_FULL_TABLE=true
TAP_AKENEO_PAGE_SIZE=100
TAP_AKENEO_INCLUDE_ENTERPRISE=false
# Only used with FULL_TABLE=false, on SaaS/servers configured for UTC.
# TAP_AKENEO_START_DATE=2026-01-01T00:00:00Z
